# ===== 应用 =====
APP_NAME=AI短剧工坊
DATABASE_URL=sqlite:///./data/platform.db
SECRET_KEY=请替换为随机长字符串
JWT_EXPIRE_MINUTES=1440

# ===== LLM（内容生成）=====
LLM_PROVIDER=mock            # mock | deepseek | openai
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ===== MiniMax（可选：文本/生图/生视频/TTS 全能力，未配火山时自动使用）=====
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com
MINIMAX_CHAT_MODEL=MiniMax-Text-01
MINIMAX_IMAGE_MODEL=image-01
MINIMAX_VIDEO_MODEL=MiniMax-H3
MINIMAX_VIDEO_RESOLUTION=768P
MINIMAX_TTS_MODEL=speech-02-hd
MINIMAX_TTS_VOICE_FEMALE=female-shaonv
MINIMAX_TTS_VOICE_MALE=male-qn-jingying

# ===== 火山方舟 Seedream（图片）=====
SEEDREAM_API_KEY=
SEEDREAM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDREAM_MODEL=doubao-seedream-5-0-260128

# ===== 火山方舟 Seedance（视频）=====
SEEDANCE_API_KEY=
SEEDANCE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDANCE_MODEL=doubao-seedance-2-0-fast-260128
SEEDANCE_DURATION=10
SEEDANCE_RESOLUTION=720p
SEEDANCE_RATIO=9:16
SEEDANCE_WATERMARK=false
SEEDANCE_POLL_INTERVAL=5
SEEDANCE_MAX_WAIT_MINUTES=30

# ===== 火山语音 Seed Audio（配音/音乐）=====
SEED_AUDIO_API_KEY=
SEED_AUDIO_BASE_URL=https://openspeech.bytedance.com
SEED_AUDIO_MODEL=seed-audio-1.0
SEED_AUDIO_FORMAT=mp3
SEED_AUDIO_SAMPLE_RATE=24000

# ===== 计费（单位：分/元）=====
PRICE_LLM_INPUT_CENTS_PER_M=100
PRICE_LLM_OUTPUT_CENTS_PER_M=200
PRICE_VIDEO_CENTS_PER_SECOND=50
PLATFORM_MARKUP=1.5
SIGNUP_BONUS_CENTS=1000

# ===== 流水线（阶段 8）=====
TASK_RETRY_ATTEMPTS=3
RESUME_ON_STARTUP=true
MAX_CONCURRENT_PROJECTS=2
EPISODE_BUDGET_RATIO=0.9
EVENT_LOG_MAX_LINES=2000
COLLECTION_ENABLED=true

# ===== 上线配置（阶段 11）=====
CORS_ORIGINS=*                 # 上线收紧：https://your.domain.com
AI_SUBTITLE_LABEL=true         # 成片字幕首行标注"AI 生成内容"

# ===== 火山资源包预检（可选，用 AK/SK 查询余额）=====
VOLC_ACCESS_KEY=
VOLC_SECRET_KEY=
